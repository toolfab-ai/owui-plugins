# Open WebUI Test Environment Configuration
# Copy this file to .env and fill in the values

# --- AI Provider Configuration ---
# Generic OpenAI-compatible API configuration
# (e.g. Kilo, OpenAI, Anthropic via gateway, etc.)

# The API Key for the provider
BOOTSTRAP_OPENAI_API_KEY=your_api_key_here

# Base URL for the OpenAI-compatible API
# Example: https://api.kilo.ai/api/gateway
BOOTSTRAP_OPENAI_API_BASE_URL=https://api.kilo.ai/api/gateway

# Model ID to use and make public
# Example: stepfun/step-3.7-flash:free
BOOTSTRAP_OPENAI_API_MODEL_ID=stepfun/step-3.7-flash:free

# --- Open WebUI Base ---
# Port where the web interface will be accessible (default: 3000)
OWUI_PORT=3000

# --- Advanced / Multi-URL Support ---
# CORS_ALLOW_ORIGIN=https://new.url.com
# Set to * to allow all (less secure, good for debugging)
CORS_ALLOW_ORIGIN=*

# Primary URL for the WebUI (e.g. https://new.url.com)
WEBUI_URL=

# --- Admin Credentials (for initial setup) ---
# ADMIN_EMAIL=admin@test.com
# ADMIN_PASSWORD=testpassword123
